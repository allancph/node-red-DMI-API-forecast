);\n        array = buffer;\n    } else {\n        return null;\n    }\n}\n\nlet foundValidData = false;\n\nfor (let i = 0; i < array.length; i++) {\n    let dateTest = new Date(array[i].properties.step);\n    if (dateTest - dateNow >= 0) {       // Don't send old data \n        const waterLevel = Math.round(100 * (array[i].properties['sea-mean-deviation'] || 0));\n        msg.payload = waterLevel;\n        msg.topic = \"Sea water level, cm\";\n        msg.timestamp = array[i].properties.step;\n        \n        // Add to buffer\n        buffer.push(array[i]);\n        if (buffer.length > MAX_BUFFER_SIZE) {\n            buffer.shift(); // Remove oldest entry\n        }\n        \n        // Update last DMI update time in global context\n        global.set('lastDMIUpdate', dateNow.getTime());\n        \n        node.status({fill:\"green\", shape:\"dot\", \n            text:`Level: ${waterLevel}cm at ${dateTest.toLocaleTimeString()} (Buffer: ${buffer.length})`});\n        foundValidData = true;\n        node.send(msg);\n    }\n}\n\n// Save buffer\ncontext.set('dataBuffer', buffer);\n\nif (!foundValidData) {\n    node.warn('No future water level predictions found');\n    node.status({fill:\"yellow\", shape:\"ring\", text:\"No future data (Buffer: ${buffer.length})\"});\n}\n\nnode.done();\nreturn null;","outputs":1,"initialize":"// Initialize buffer\ncontext.set('dataBuffer', []);\nglobal.set('lastDMIUpdate', null);","finalize":"","libs":[],"x":780,"y":120,"wires":[["55d59c0d47fe7c5c","2e7765274745c1fb"]]},{"id":"5a5072455f477357","type":"function","z":"2a78f8461fb14376","name":"Get wind speed & wind direction","func":"let array = msg.payload.features || [];\nlet dateNow = new Date();\n\n// Get or initialize buffer\nlet buffer = context.get('dataBuffer') || [];\nconst MAX_BUFFER_SIZE = 60; // 1 minute of data\n\nif (!array.length) {\n    node.warn('No wind data received');\n    node.status({fill:\"red\", shape:\"ring\", text:\"No data\"});\n    \n    // If we have buffered data, use it\n    if (buffer.length > 0) {\n        node.warn('Using buffered data');\n        array = buffer;\n    } else {\n        return null;\n    }\n}\n\nlet foundValidData = false;\n\nfor (let i = 0; i < array.length; i++) {\n    let dateTest = new Date(array[i].properties.step);\n    if (dateTest - dateNow >= 0) {       // Don't send old data \n        const windSpeed = Math.round((array[i].properties['wind-speed'] || 0) * 10) / 10;\n        const windDir = Math.round(array[i].properties['wind-dir'] || 0);\n        \n        let wind = {\n            payload: windSpeed,\n            topic: \"Wind speed m/s\",\n            timestamp: array[i].properties.step\n        };\n\n        let direction = {\n            payload: windDir,\n            topic: \"Wind direction degrees\",\n            timestamp: array[i].properties.step\n        };\n\n        // Add to buffer\n        buffer.push(array[i]);\n        if (buffer.length > MAX_BUFFER_SIZE) {\n            buffer.shift(); // Remove oldest entry\n        }\n\n        node.status({fill:\"green\", shape:\"dot\", \n            text:`${windSpeed}m/s at ${windDir}° (Buffer: ${buffer.length})`});\n        foundValidData = true;\n        node.send([wind, direction]);\n    }\n}\n\n// Save buffer\ncontext.set('dataBuffer', buffer);\n\nif (!foundValidData) {\n    node.warn('No future wind predictions found');\n    node.status({fill:\"yellow\", shape:\"ring\", text:\"No future data (Buffer: ${buffer.length})\"});\n}\n\nnode.done();\nreturn null;","outputs":2,"noerr":0,"initialize":"// Initialize buffer\ncontext.set('dataBuffer', []);","finalize":"","libs":[],"x":710,"y":220,"wires":[["c968d7774217556b"],["dfb7a2f56479171e"]]},{"id":"55d59c0d47fe7c5c","type":"ui_chart","z":"2a78f8461fb14376","name":"","group":"9a4af0e5e36ffebc","order":2,"width":10,"height":3,"label":"Water level, cm","chartType":"line","legend":"false","xformat":"dd HH:mm","interpolate":"linear","nodata":"","dot":false,"ymin":"","ymax":"","removeOlder":"6","removeOlderPoints":"","removeOlderUnit":"86400","cutout":0,"useOneColor":false,"useUTC":false,"colors":["#1f77b4","#aec7e8","#ff7f0e","#2ca02c","#98df8a","#d62728","#ff9896","#9467bd","#c5b0d5"],"outputs":1,"useDifferentColor":false,"className":"","x":860,"y":80,"wires":[[]]},{"id":"c968d7774217556b","type":"ui_chart","z":"2a78f8461fb14376","name":"","group":"9a4af0e5e36ffebc","order":4,"width":10,"height":3,"label":"Wind speed, m/s","chartType":"line","legend":"false","xformat":"dd HH:mm","interpolate":"linear","nodata":"","dot":false,"ymin":"","ymax":"","removeOlder":"6","removeOlderPoints":"","removeOlderUnit":"86400","cutout":0,"useOneColor":false,"useUTC":false,"colors":["#1f77b4","#aec7e8","#ff7f0e","#2ca02c","#98df8a","#d62728","#ff9896","#9467bd","#c5b0d5"],"outputs":1,"useDifferentColor":false,"className":"","x":850,"y":120,"wires":[[]]},{"id":"dfb7a2f56479171e","type":"ui_chart","z":"2a78f8461fb14376","name":"","group":"9a4af0e5e36ffebc","order":6,"width":10,"height":3,"label":"Wind direction, degrees","chartType":"line","legend":"false","xformat":"dd HH:mm","interpolate":"linear","nodata":"","dot":false,"ymin":"","ymax":"","removeOlder":"6","removeOlderPoints":"","removeOlderUnit":"86400","cutout":0,"useOneColor":false,"useUTC":false,"colors":["#1f77b4","#aec7e8","#ff7f0e","#2ca02c","#98df8a","#d62728","#ff9896","#9467bd","#c5b0d5"],"outputs":1,"useDifferentColor":false,"className":"","x":830,"y":160,"wires":[[]]},{"id":"4b2b59035f7d67f3","type":"change","z":"2a78f8461fb14376","name":"Clear chart","rules":[{"t":"set","p":"payload","pt":"msg","to":"[]","tot":"json"}],"action":"","property":"","from":"","to":"","reg":false,"x":610,"y":120,"wires":[["55d59c0d47fe7c5c","c968d7774217556b","dfb7a2f56479171e"]]},{"id":"5d99100aa0b30479","type":"ui_button","z":"2a78f8461fb14376","name":"","group":"9a4af0e5e36ffebc","order":8,"width":10,"height":1,"passthru":false,"label":"Clear charts","tooltip":"","color":"","bgcolor":"","className":"","icon":"","payload":"","payloadType":"date","topic":"topic","topicType":"msg","x":90,"y":340,"wires":[["4b2b59035f7d67f3"]]},{"id":"149b6f710a3c0f13","type":"function","z":"2a78f8461fb14376","name":"Format Position","func":"// Track connection health\nconst lastReceived = context.get('lastReceived') || 0;\nconst timeNow = Date.now();\nconst timeSinceLastData = (timeNow - lastReceived) / 1000; // seconds\n\n// Update connection status\nif (timeSinceLastData > 30) { // No data for 30 seconds\n    node.status({fill:\"red\", shape:\"ring\", text:\"SignalK Connection Lost\"});\n} else if (timeSinceLastData > 10) { // No data for 10 seconds\n    node.status({fill:\"yellow\", shape:\"ring\", text:\"SignalK Connection Unstable\"});\n}\n\nconst lon = msg.payload.longitude;\nconst lat = msg.payload.latitude;\n\n// Check for valid coordinates\nif (lon === undefined || lat === undefined || isNaN(lon) || isNaN(lat)) {\n    node.warn(\"Position data invalid - lon: \" + lon + \", lat: \" + lat);\n    // Use last known good position if available\n    const lastGoodPos = context.get('lastGoodPosition');\n    if (lastGoodPos) {\n        node.warn(\"Using last known good position: \" + JSON.stringify(lastGoodPos));\n        msg.position = lastGoodPos.position;\n        return msg;\n    }\n    if (!context.get('latestPosition')) {\n        msg.retry = true;\n        return msg;\n    }\n    return null;\n}\n\n// Update last received timestamp and good position\ncontext.set('lastReceived', timeNow);\ncontext.set('lastGoodPosition', { lat: lat, lon: lon, position: `POINT(${lon} ${lat})` });\n\nconst roundedLon = Number(lon).toFixed(4);\nconst roundedLat = Number(lat).toFixed(4);\n\n// Get last update time and position\nconst lastUpdate = context.get('lastUpdate') || 0;\nconst lastPos = context.get('lastPos');\n\n// Calculate distance if we have a previous position\nlet distance = 0;\nif (lastPos) {\n    const R = 6371; // Earth's radius in km\n    const dLat = (lat - lastPos.lat) * Math.PI / 180;\n    const dLon = (lon - lastPos.lon) * Math.PI / 180;\n    const a = Math.sin(dLat/2) * Math.sin(dLat/2) +\n              Math.cos(lastPos.lat * Math.PI / 180) * Math.cos(lat * Math.PI / 180) * \n              Math.sin(dLon/2) * Math.sin(dLon/2);\n    const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));\n    distance = R * c;\n}\n\n// Convert to nautical miles\ndistance = distance * 0.539957;\n\n// Check if we should update (5nm moved or 1 hour passed)\nconst hoursPassed = (timeNow - lastUpdate) / (1000 * 60 * 60);\n\nif (distance >= 5 || hoursPassed >= 1 || !lastUpdate) {\n    msg.position = `POINT(${roundedLon} ${roundedLat})`;\n    context.set('latestPosition', msg.position);\n    context.set('lastUpdate', timeNow);\n    context.set('lastPos', { lat: Number(lat), lon: Number(lon) });\n    \n    node.status({fill:\"green\", shape:\"dot\", text:`Updated: Distance=${distance.toFixed(1)}nm, Time=${hoursPassed.toFixed(1)}h`});\n    msg.retry = false;\n    return msg;\n} else {\n    node.status({fill:\"blue\", shape:\"ring\", text:`Skipped: Distance=${distance.toFixed(1)}nm, Time=${hoursPassed.toFixed(1)}h`});\n    return null;\n}","outputs":1,"timeout":"","noerr":0,"initialize":"// Clear stored position and time on deploy\ncontext.set('lastUpdate', null);\ncontext.set('lastPos', null);\ncontext.set('latestPosition', null);\ncontext.set('lastReceived', null);\ncontext.set('lastGoodPosition', null);\ncontext.set('dataBuffer', []);","finalize":"","libs":[],"x":224,"y":120,"wires":[["2ccb9ad379143717"]]},{"id":"2ccb9ad379143717","type":"switch","z":"2a78f8461fb14376","name":"Retry Check","property":"retry","propertyType":"msg","rules":[{"t":"true"},{"t":"else"}],"checkall":"true","repair":false,"outputs":2,"x":250,"y":180,"wires":[["85d807fec804487b"],["2fde3261c6cada09"]]},{"id":"85d807fec804487b","type":"delay","z":"2a78f8461fb14376","name":"Retry Delay","pauseType":"delay","timeout":"10","timeoutUnits":"seconds","rate":"1","nbRateUnits":"1","rateUnits":"second","randomFirst":